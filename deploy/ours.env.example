# Bind address (LAN + Cloudflare Tunnel on localhost)
OURS_BIND=0.0.0.0:8080

# Data directory (SQLite DB, token_secret, photos/)
OURS_DATA_DIR=/var/lib/ours

# Optional setup key for initial pairing (POST /api/pair/create with X-Setup-Key header).
# Leave unset/empty to allow first-user pairing without a setup key.
# OURS_SETUP_KEY=change-me-to-a-long-random-string

# Optional: auto-generated in OURS_DATA_DIR/token_secret if omitted
# OURS_TOKEN_SECRET=

# Location history retention in days (0 disables history storage)
OURS_HISTORY_DAYS=30

# Minutes without any authenticated request before sending an FCM wake push
OURS_STALE_MINUTES=15

# Optional path to Firebase service account JSON for FCM pushes
# OURS_FCM_SERVICE_ACCOUNT=/etc/ours/firebase-service-account.json

# Logging level
RUST_LOG=info
